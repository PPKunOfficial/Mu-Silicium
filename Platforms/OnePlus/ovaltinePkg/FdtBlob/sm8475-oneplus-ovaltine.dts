		pinctrl@3440000 {
			compatible = "qcom,sm8450-lpass-lpi-pinctrl";
			reg = <0x00 0x3440000 0x00 0x20000 0x00 0x34d0000 0x00 0x10000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0xdc 0x00 0x00 0x17>;
			clocks = <0xac 0x66 0x01 0xac 0x67 0x01>;
			clock-names = "core", "audio";
			phandle = <0xdc>;

			tx-swr-active-state {
				phandle = <0xb5>;

				clk-pins {
					pins = "gpio0";
					function = "swr_tx_clk";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};

				data-pins {
					pins = "gpio1", "gpio2", "gpio14";
					function = "swr_tx_data";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			rx-swr-active-state {
				phandle = <0xb1>;

				clk-pins {
					pins = "gpio3";
					function = "swr_rx_clk";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};

				data-pins {
					pins = "gpio4", "gpio5";
					function = "swr_rx_data";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			dmic01-default-state {

				clk-pins {
					pins = "gpio6";
					function = "dmic1_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio7";
					function = "dmic1_data";
					drive-strength = <0x08>;
				};
			};

			dmic23-default-state {

				clk-pins {
					pins = "gpio8";
					function = "dmic2_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio9";
					function = "dmic2_data";
					drive-strength = <0x08>;
				};
			};

			wsa-swr-active-state {
				phandle = <0xb3>;

				clk-pins {
					pins = "gpio10";
					function = "wsa_swr_clk";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};

				data-pins {
					pins = "gpio11";
					function = "wsa_swr_data";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			wsa2-swr-active-state {
				phandle = <0xaf>;

				clk-pins {
					pins = "gpio15";
