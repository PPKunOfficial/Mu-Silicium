/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "OnePlus 10T (CPH2413/CPH2415) - SM8475";
	compatible = "oneplus,cph2413", "oneplus,ovaltine", "qcom,sm8475";
	qcom,msm-id = <0x212 0x10000>;
	qcom,board-id = <0x00 0x00>;
	oplus,project-id = <0x5551 0x5552>;
	chassis-type = "handset";

	chosen {
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x493e000>;
			phandle = <0x100>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			phandle = <0x3c>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x00>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x03>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			clocks = <0x04 0x00>;
			phandle = <0x14>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x05>;
				phandle = <0x02>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x05>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x100>;
			enable-method = "psci";
			next-level-cache = <0x06>;
			power-domains = <0x07>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			clocks = <0x04 0x00>;
			phandle = <0x15>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x05>;
				phandle = <0x06>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x200>;
			enable-method = "psci";
			next-level-cache = <0x08>;
			power-domains = <0x09>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			clocks = <0x04 0x00>;
			phandle = <0x16>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x05>;
				phandle = <0x08>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x300>;
			enable-method = "psci";
			next-level-cache = <0x0a>;
			power-domains = <0x0b>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x00>;
			#cooling-cells = <0x02>;
			clocks = <0x04 0x00>;
			phandle = <0x17>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x05>;
				phandle = <0x0a>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x400>;
			enable-method = "psci";
			next-level-cache = <0x0c>;
			power-domains = <0x0d>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x01>;
			#cooling-cells = <0x02>;
			clocks = <0x04 0x01>;
			phandle = <0x18>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x05>;
				phandle = <0x0c>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x500>;
			enable-method = "psci";
			next-level-cache = <0x0e>;
			power-domains = <0x0f>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x01>;
			#cooling-cells = <0x02>;
			clocks = <0x04 0x01>;
			phandle = <0x19>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x05>;
				phandle = <0x0e>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x600>;
			enable-method = "psci";
			next-level-cache = <0x10>;
			power-domains = <0x11>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x01>;
			#cooling-cells = <0x02>;
			clocks = <0x04 0x01>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x05>;
				phandle = <0x10>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo780";
			reg = <0x00 0x700>;
			enable-method = "psci";
			next-level-cache = <0x12>;
			power-domains = <0x13>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x04 0x02>;
			#cooling-cells = <0x02>;
			clocks = <0x04 0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x05>;
				phandle = <0x12>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x14>;
				};

				core1 {
					cpu = <0x15>;
				};

				core2 {
					cpu = <0x16>;
				};

				core3 {
					cpu = <0x17>;
				};

				core4 {
					cpu = <0x18>;
				};

				core5 {
					cpu = <0x19>;
				};

				core6 {
					cpu = <0x1a>;
				};

				core7 {
					cpu = <0x1b>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "silver-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x320>;
				exit-latency-us = <0x2ee>;
				min-residency-us = <0xffa>;
				local-timer-stop;
				phandle = <0x32>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "gold-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x60e>;
				min-residency-us = <0x12b7>;
				local-timer-stop;
				phandle = <0x33>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0x41a>;
				exit-latency-us = <0x9c4>;
				min-residency-us = <0x14bd>;
				phandle = <0x34>;
			};

			cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100c344>;
				entry-latency-us = <0xa8c>;
				exit-latency-us = <0xdac>;
				min-residency-us = <0x3687>;
				phandle = <0x35>;
			};
		};
	};

	ete-0 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x14>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x1c>;
					phandle = <0x25>;
				};
			};
		};
	};

	ete-1 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x15>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x1d>;
					phandle = <0x26>;
				};
			};
		};
	};

	ete-2 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x16>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x1e>;
					phandle = <0x27>;
				};
			};
		};
	};

	ete-3 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x17>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x1f>;
					phandle = <0x28>;
				};
			};
		};
	};

	ete-4 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x18>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x20>;
					phandle = <0x29>;
				};
			};
		};
	};

	ete-5 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x19>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x21>;
					phandle = <0x2a>;
				};
			};
		};
	};

	ete-6 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x1a>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x22>;
					phandle = <0x2b>;
				};
			};
		};
	};

	ete-7 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x1b>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x23>;
					phandle = <0x2c>;
				};
			};
		};
	};

	funnel-ete {
		compatible = "arm,coresight-static-funnel";

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x24>;
					phandle = <0xfe>;
				};
			};
		};

		in-ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				endpoint {
					remote-endpoint = <0x25>;
					phandle = <0x1c>;
				};
			};

			port@1 {
				reg = <0x01>;

				endpoint {
					remote-endpoint = <0x26>;
					phandle = <0x1d>;
				};
			};

			port@2 {
				reg = <0x02>;

				endpoint {
					remote-endpoint = <0x27>;
					phandle = <0x1e>;
				};
			};

			port@3 {
				reg = <0x03>;

				endpoint {
					remote-endpoint = <0x28>;
					phandle = <0x1f>;
				};
			};

			port@4 {
				reg = <0x04>;

				endpoint {
					remote-endpoint = <0x29>;
					phandle = <0x20>;
				};
			};

			port@5 {
				reg = <0x05>;

				endpoint {
					remote-endpoint = <0x2a>;
					phandle = <0x21>;
				};
			};

			port@6 {
				reg = <0x06>;

				endpoint {
					remote-endpoint = <0x2b>;
					phandle = <0x22>;
				};
			};

			port@7 {
				reg = <0x07>;

				endpoint {
					remote-endpoint = <0x2c>;
					phandle = <0x23>;
				};
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm8450", "qcom,scm";
			qcom,dload-mode = <0x2d 0x13000>;
			interconnects = <0x2e 0x04 0x00 0x2f 0x01 0x00>;
			#reset-cells = <0x01>;
		};
	};

	interconnect-0 {
		compatible = "qcom,sm8450-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x30>;
		phandle = <0x44>;
	};

	interconnect-1 {
		compatible = "qcom,sm8450-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x30>;
		phandle = <0x2f>;
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x6a000000 0x00 0xf1400000 0x00 0xec00000 0x08 0x00 0x00 0x38300000 0x09 0x80000000 0x00 0x2000000 0x08 0x40000000 0x00 0x1400000>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x03>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x07>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x09>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x0b>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x33>;
			phandle = <0x0d>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x33>;
			phandle = <0x0f>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x33>;
			phandle = <0x11>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x33>;
			phandle = <0x13>;
		};

		power-domain-cpu-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x34 0x35>;
			phandle = <0x31>;
		};
	};

	opp-table-qup {
		compatible = "operating-points-v2";
		phandle = <0x63>;

		opp-50000000 {
			opp-hz = <0x00 0x2faf080>;
			required-opps = <0x36>;
		};

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x37>;
		};

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
			required-opps = <0x38>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@80000000 {
			reg = <0x00 0x80000000 0x00 0x600000>;
			no-map;
		};

		memory@80600000 {
			reg = <0x00 0x80600000 0x00 0x40000>;
			no-map;
		};

		memory@80640000 {
			reg = <0x00 0x80640000 0x00 0x1c0000>;
			no-map;
		};

		memory@80800000 {
			reg = <0x00 0x80800000 0x00 0x60000>;
			no-map;
		};

		memory@80860000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x80860000 0x00 0x20000>;
			no-map;
		};

		memory@80880000 {
			reg = <0x00 0x80880000 0x00 0x20000>;
			no-map;
		};

		memory@808a0000 {
			reg = <0x00 0x808a0000 0x00 0x40000>;
			no-map;
		};

		memory@808e0000 {
			reg = <0x00 0x808e0000 0x00 0x4000>;
			no-map;
		};

		memory@808e4000 {
			reg = <0x00 0x808e4000 0x00 0x10000>;
			no-map;
		};

		memory@80900000 {
			compatible = "qcom,smem";
			reg = <0x00 0x80900000 0x00 0x200000>;
			hwlocks = <0x39 0x03>;
			no-map;
		};

		memory@80b00000 {
			reg = <0x00 0x80b00000 0x00 0x100000>;
			no-map;
		};

		memory@80c00000 {
			reg = <0x00 0x80c00000 0x00 0x100000>;
			no-map;
		};

		memory@85700000 {
			reg = <0x00 0x85700000 0x00 0x700000>;
			no-map;
		};

		memory@85e00000 {
			reg = <0x00 0x85e00000 0x00 0x2100000>;
			no-map;
			phandle = <0xaa>;
		};

		memory@88000000 {
			reg = <0x00 0x87f00000 0x00 0x1a00000>;
			no-map;
			phandle = <0xa7>;
		};

		memory@89900000 {
			reg = <0x00 0x89900000 0x00 0x2000000>;
			no-map;
			phandle = <0xb7>;
		};

		memory@8b900000 {
			reg = <0x00 0x8b900000 0x00 0x10000>;
			no-map;
		};

		memory@8b910000 {
			reg = <0x00 0x8b910000 0x00 0xa000>;
			no-map;
		};

		memory@8b91a000 {
			reg = <0x00 0x8b91a000 0x00 0x2000>;
			no-map;
			phandle = <0x9c>;
		};

		memory@8ba00000 {
			reg = <0x00 0x8ba00000 0x00 0x180000>;
			no-map;
		};

		memory@8bb80000 {
			reg = <0x00 0x8bb80000 0x00 0x60000>;
			no-map;
		};

		memory@8bbe0000 {
			reg = <0x00 0x8bbe0000 0x00 0x20000>;
			no-map;
		};

		memory@8bc00000 {
			reg = <0x00 0x8bc00000 0x00 0x13200000>;
			no-map;
			phandle = <0xba>;
		};

		memory@9ee00000 {
			reg = <0x00 0x9ee00000 0x00 0x700000>;
			no-map;
		};

		memory@9f500000 {
			reg = <0x00 0x9f500000 0x00 0x800000>;
			no-map;
		};

		memory@9fd00000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0x9fd00000 0x00 0x280000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f>;
		};

		memory@a6e00000 {
			reg = <0x00 0xa6e00000 0x00 0x40000>;
			no-map;
		};

		memory@a6f00000 {
			reg = <0x00 0xa6f00000 0x00 0x100000>;
			no-map;
		};

		memory@bb000000 {
			reg = <0x00 0xbb000000 0x00 0x5000000>;
			no-map;
		};

		memory@c0000000 {
			reg = <0x00 0xc0000000 0x00 0x20000000>;
			no-map;
		};

		memory@e0000000 {
			reg = <0x00 0xe0000000 0x00 0x00>;
			no-map;
		};

		memory@e0600000 {
			reg = <0x00 0xe0600000 0x00 0x400000>;
			no-map;
		};

		memory@e0a00000 {
			reg = <0x00 0xe0a00000 0x00 0x100000>;
			no-map;
		};

		memory@e0b00000 {
			reg = <0x00 0xe0b00000 0x00 0x4af3000>;
			no-map;
		};

		memory@e55f3000 {
			reg = <0x00 0xe55f3000 0x00 0x9000>;
			no-map;
		};

		memory@e55fc000 {
			reg = <0x00 0xe55fc000 0x00 0x4000>;
			no-map;
		};

		memory@e5600000 {
			reg = <0x00 0xe5600000 0x00 0x100000>;
			no-map;
		};

		memory@e8800000 {
			reg = <0x00 0xe8800000 0x00 0x100000>;
			no-map;
		};

		memory@e8900000 {
			reg = <0x00 0xe8900000 0x00 0x1200000>;
			no-map;
		};

		memory@e9b00000 {
			reg = <0x00 0xe9b00000 0x00 0x500000>;
			no-map;
		};

		memory@ea000000 {
			reg = <0x00 0xea000000 0x00 0x3900000>;
			no-map;
		};

		memory@ed900000 {
			reg = <0x00 0xed900000 0x00 0x3b00000>;
			no-map;
		};

		ramoops@a7000000 {
			compatible = "ramoops";
			reg = <0x00 0xa7000000 0x00 0x240000>;
			console-size = <0x40000>;
			pmsg-size = <0x200000>;
			ecc-size = <0x00>;
			no-map;
		};

		botloader_mem@a7605000 {
			reg = <0x00 0xa7605000 0x00 0x8000>;
			no-map;
		};

		diag_mem@a760d000 {
			reg = <0x00 0xa760d000 0x00 0x1000>;
			no-map;
